			"name": "2. POST /api/test-login",
			"item": [
				{
					"name": "2.1 ✅ Success — Valid credentials",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"{{test_email}}\",\n    \"password\": \"{{test_password}}\",\n    \"client_id\": \"{{client_id}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/test-login",
							"host": ["{{base_url}}"],
							"path": ["api", "test-login"]
						},
						"description": "Login sukses → return access_token dan refresh_token.\nToken otomatis disimpan ke collection variable untuk dipakai request selanjutnya."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Response contains access_token and refresh_token', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('access_token');",
									"    pm.expect(jsonData).to.have.property('refresh_token');",
									"    pm.expect(jsonData.access_token).to.be.a('string').and.not.empty;",
									"    pm.expect(jsonData.refresh_token).to.be.a('string').and.not.empty;",
									"});",
									"",
									"pm.test('Access token is valid JWT format (3 parts)', function () {",
									"    var jsonData = pm.response.json();",
									"    var parts = jsonData.access_token.split('.');",
									"    pm.expect(parts).to.have.lengthOf(3);",
									"});",
									"",
									"// Auto-save tokens ke collection variable",
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set('access_token', jsonData.access_token);",
									"    pm.collectionVariables.set('refresh_token', jsonData.refresh_token);",
									"    console.log('✅ Tokens saved to collection variables');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"response": []
