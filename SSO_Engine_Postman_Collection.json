						},
						"url": {
							"raw": "{{base_url}}/refresh-token",
							"host": ["{{base_url}}"],
							"path": ["refresh-token"]
						},
						"description": "Refresh token valid → return access_token baru + refresh_token baru (rotasi).\nVariable otomatis di-update."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Response contains new access_token and refresh_token', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('access_token');",
									"    pm.expect(jsonData).to.have.property('refresh_token');",
									"    pm.expect(jsonData.access_token).to.be.a('string').and.not.empty;",
									"    pm.expect(jsonData.refresh_token).to.be.a('string').and.not.empty;",
									"});",
									"",
									"pm.test('New refresh_token is different from old one (rotation)', function () {",
									"    var jsonData = pm.response.json();",
									"    var oldToken = pm.collectionVariables.get('refresh_token');",
									"    pm.expect(jsonData.refresh_token).to.not.eql(oldToken);",
									"});",
									"",
									"// Auto-update tokens",
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set('access_token', jsonData.access_token);",
									"    pm.collectionVariables.set('refresh_token', jsonData.refresh_token);",
									"    console.log('✅ Tokens updated after refresh');",
									"}"
								],
								"type": "text/javascript"
							}
						}
