		{
			"key": "base_url",
			"value": "http://sso-engine.test",
			"type": "string"
		},
		{
			"key": "client_id",
			"value": "mymember-client",
			"type": "string"
		},
		{
			"key": "redirect_uri",
			"value": "http://mymember.test/auth/callback",
			"type": "string"
		},
		{
			"key": "test_email",
			"value": "labibfarrel960@gmail.com",
			"type": "string"
		},
		{
			"key": "test_password",
			"value": "ISI_PASSWORD_KAMU_DISINI",
			"type": "string"
		},
		{
			"key": "access_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "refresh_token",
			"value": "",
			"type": "string"
		}
