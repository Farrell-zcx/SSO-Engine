							"raw": "{{base_url}}/authorize?client_id={{client_id}}&redirect_uri={{redirect_uri}}&state=test-state-csrf-123",
							"host": ["{{base_url}}"],
							"path": ["authorize"],
							"query": [
								{ "key": "client_id", "value": "{{client_id}}" },
								{ "key": "redirect_uri", "value": "{{redirect_uri}}" },
								{ "key": "state", "value": "test-state-csrf-123" }
